<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.smeltr.watchdog</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/snowball/Developer/git/smeltr/ops/watchdog.sh</string>
  </array>
  <key>StartInterval</key><integer>60</integer>
  <key>RunAtLoad</key><true/>
  <!-- launchd's PATH has no Homebrew. A driver this watchdog restarts inherits
       it, and on 2026-09-11 that driver looped on "nohup: HandBrakeCLI: No such
       file or directory" for six minutes while the dashboard showed an encode
       that never started. HandBrakeCLI and ffprobe are Homebrew's. -->
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <!-- NOT on the staging drive: launchd cannot create a log on a volume that
       may be unmounted, and fails the job with EX_CONFIG (78) before it runs. -->
  <key>StandardOutPath</key><string>/Users/snowball/Library/Logs/smeltr/watchdog.out.log</string>
  <key>StandardErrorPath</key><string>/Users/snowball/Library/Logs/smeltr/watchdog.err.log</string>
</dict>
</plist>
