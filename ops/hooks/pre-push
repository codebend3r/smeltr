#!/bin/bash
# The full suite before anything leaves this machine: ~10 s.
#
# `tests/run-all.sh` is the same gate `npm version` runs as `preversion`, so a
# push and a release are held to one standard. It includes the staging drift
# check -- the one suite that genuinely needs the X9 mounted, and which SKIPS
# cleanly (exit 0) when it is not, so pushing from a machine with no drive
# still works.
#
# Nothing here touches the NAS, the staging drive, or the running driver.
#
# Bypass: `git push --no-verify`, or SMELTR_SKIP_HOOKS=1.
set -uo pipefail

[ "${SMELTR_SKIP_HOOKS:-}" = "1" ] && { echo "pre-push: skipped (SMELTR_SKIP_HOOKS=1)"; exit 0; }

cd "$(git rev-parse --show-toplevel)" || exit 1

# Git feeds "<local ref> <local sha> <remote ref> <remote sha>" per ref on
# stdin. An all-zero local sha is a ref DELETION -- there is no tree to test,
# so running the suite would only be a way to refuse a branch cleanup.
have_commits=0
while read -r _local_ref local_sha _remote_ref _remote_sha; do
  [ -z "${local_sha:-}" ] && continue
  case "$local_sha" in
    *[!0]*) have_commits=1 ;;
  esac
done

if [ "$have_commits" -eq 0 ]; then
  echo "pre-push: nothing but ref deletions -- no suite to run."
  exit 0
fi

bash tests/run-all.sh || {
  echo
  echo "pre-push: suite failed. Nothing was pushed."
  echo "If the failure is staging drift, deploy with ops/deploy-staging.sh"
  echo "(--dry-run first) or copy the live script back -- do not edit the"
  echo "mirror alone."
  echo "To push anyway: git push --no-verify."
  exit 1
}
