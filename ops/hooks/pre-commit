#!/bin/bash
# Fast gate on every commit: ~1.3 s. The full suite is pre-push.
#
# Two checks, in cost order:
#   1. nothing carrying the auth token (or the ledger) is in the INDEX. The
#      .gitignore covers these and test_repo_invariants.py asserts they are
#      untracked -- but that test reads `git ls-files`, so a `git add -f token`
#      only trips it AFTER the commit exists. This one reads the index, so it
#      refuses before the object is written.
#   2. tests/lint.sh -- ruff, compileall, shellcheck, `node --check`, and the
#      "page still assembles with no placeholder left" check.
#
# lint.sh reads the WORKING TREE, not the index. That is deliberate: stashing
# unstaged work to lint the index exactly is how a hook loses somebody's edits,
# and this repo drives live infrastructure. A partial commit is therefore
# linted against what is on disk, which is what you are about to run anyway.
#
# Bypass: `git commit --no-verify`, or SMELTR_SKIP_HOOKS=1.
set -uo pipefail

[ "${SMELTR_SKIP_HOOKS:-}" = "1" ] && { echo "pre-commit: skipped (SMELTR_SKIP_HOOKS=1)"; exit 0; }

cd "$(git rev-parse --show-toplevel)" || exit 1

# ------------------------------------------------------------ runtime secrets
# Same list as test_repo_invariants.py::RuntimeArtifacts.NEVER, plus the ledger.
staged="$(git diff --cached --name-only --diff-filter=AM)"
bad=""
while IFS= read -r f; do
  case "$f" in
    token|url|server.pid|server.log|sysmon.ring|queue_overrides.json|pause|ledger.jsonl)
      bad="$bad  $f"$'\n' ;;
    .claude/worktrees/*)
      bad="$bad  $f"$'\n' ;;
  esac
done <<< "$staged"

if [ -n "$bad" ]; then
  echo "pre-commit: REFUSED -- runtime artifact(s) staged:"
  printf '%s' "$bad"
  echo "These are gitignored for a reason: token/url/server.log carry the"
  echo "dashboard auth token, and ledger.jsonl is rewritten on every encode."
  echo "Unstage them:  git restore --staged <file>"
  exit 1
fi

# ------------------------------------------------------------------- the lint
bash tests/lint.sh || {
  echo
  echo "pre-commit: lint failed. Fix it, or commit with --no-verify."
  exit 1
}
