; Config for `npm version`. There is no package to publish -- package.json
; exists only to drive the version bump, the tag, and the push.

; Tags are `v1.2.3`.
tag-version-prefix = "v"

; Commit AND tag message. `%s` becomes the new version number. The subject has
; to carry the `SMLTR:` prefix like every other commit in this repo -- see
; .claude/skills/smeltr-commit-format/SKILL.md.
message = "SMLTR: Release v%s"

; Annotated, unsigned. `git push --follow-tags` in `postversion` only pushes
; annotated tags, so this must stay annotated.
sign-git-tag = false
