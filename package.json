{
  "name": "smeltr",
  "version": "0.1.7",
  "private": true,
  "description": "Local dashboard and ledger for a long-running 4K HEVC re-encode job",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/codebend3r/smeltr.git"
  },
  "scripts": {
    "test": "bash tests/run-all.sh",
    "test:py": "python3 -m unittest discover -s tests",
    "lint": "bash tests/lint.sh",
    "visual": "node tests/visual/shoot.mjs",
    "format": "uvx ruff format .",
    "format:check": "uvx ruff format --check .",
    "preversion": "bash tests/run-all.sh",
    "postversion": "git push --follow-tags origin HEAD"
  }
}
