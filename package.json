{
  "name": "smeltr",
  "version": "0.1.15",
  "private": true,
  "description": "Local dashboard and ledger for a long-running 4K HEVC re-encode job",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/codebend3r/smeltr.git"
  },
  "scripts": {
    "brief": "./smeltr brief",
    "brief:check": "./smeltr brief --dry-run",
    "build": "python3 tools/build_check.py",
    "currentp": "python3 tools/current_processes.py",
    "deploy:dry-run": "bash ops/deploy-staging.sh --dry-run",
    "deploy:staging": "bash ops/deploy-staging.sh",
    "format": "bun run --sequential format:js format:py",
    "format:check": "bun run --sequential format:js:check format:py:check",
    "format:js": "oxfmt",
    "format:js:check": "oxfmt --check",
    "format:py": "uvx ruff@0.16.5 format .",
    "format:py:check": "uvx ruff@0.16.5 format --check .",
    "heartbeat": "./smeltr heartbeat",
    "heartbeat:check": "./smeltr heartbeat --dry-run --confirm-seconds 0",
    "lint": "bun run --sequential lint:js lint:js:syntax lint:ts lint:py lint:py:syntax lint:sh lint:sh:staging lint:ci format:js:check lint:page",
    "lint:ci": "actionlint",
    "lint:js": "oxlint --deny-warnings",
    "lint:js:syntax": "for f in web/*.js tests/*.ts tests/visual/*.mts; do bun build --no-bundle \"$f\" --outfile /dev/null >/dev/null || exit 1; done",
    "lint:page": "python3 tests/check_page.py",
    "lint:py": "uvx ruff@0.16.5 check .",
    "lint:py:syntax": "python3 -m compileall -q pipeline dashboard tools",
    "lint:sh": "shellcheck -x -S warning smeltr $(git ls-files -co --exclude-standard '*.sh' ':!staging/*')",
    "lint:sh:staging": "shellcheck -x -S error staging/*.sh && (shellcheck -f gcc -x -S warning staging/*.sh || echo 'advisory above error level: staging/ mirrors the live X9 scripts -- fix on the drive, then copy back')",
    "lint:ts": "tsc --noEmit -p tsconfig.json",
    "notify:test": "./smeltr notify-test",
    "open": "./smeltr open",
    "postversion": "git push --follow-tags origin HEAD",
    "preinstall": "case \"$npm_config_user_agent\" in bun/*) ;; *) echo 'smeltr: this repo runs on bun -- use `bun install`, not npm/yarn/pnpm' >&2; exit 1 ;; esac",
    "prepare": "lefthook install --reset-hooks-path",
    "preversion": "bun run verify",
    "release": "bun pm version -m \"SMLTR: Release v%s\"",
    "report": "./smeltr report",
    "restart": "./smeltr restart",
    "set-password": "./smeltr set-password",
    "smoke": "bun run --sequential smoke:report smoke:next build",
    "smoke:next": "bash tests/smoke_offline.sh next",
    "smoke:report": "bash tests/smoke_offline.sh report",
    "start": "./smeltr start",
    "status": "./smeltr status",
    "stop": "./smeltr stop",
    "system-check": "bun run --sequential format:js:check lint test",
    "test": "bun run --parallel test:py 'test:sh:*' 'test:js:*'",
    "test:js:crf": "bun tests/test_crf_picker.ts",
    "test:js:low-space": "bun tests/test_low_space_ui.ts",
    "test:js:pause": "bun tests/test_pause_toggle.ts",
    "test:js:projection": "bun tests/test_projection_ui.ts",
    "test:js:repaint": "bun tests/test_repaint_key.ts",
    "test:js:sysmon-render": "bun tests/test_sysmon_render.ts",
    "test:js:sysmon-ui": "bun tests/test_sysmon_ui.ts",
    "test:js:tiers": "bun tests/test_table_tiers.ts",
    "test:py": "python3 tests/run_unittests.py",
    "test:sh:autopilot": "bash tests/test_autopilot_helpers.sh",
    "test:sh:drift": "bash tests/test_staging_in_sync.sh",
    "test:sh:launcher": "bash tests/test_launcher_pids.sh",
    "test:sh:layout": "bash tests/test_layout.sh",
    "test:sh:midwrite": "bash tests/test_midwrite_retry.sh",
    "test:sh:pusher": "bash tests/test_push_complete.sh",
    "test:sh:replenisher": "bash tests/test_replenisher.sh",
    "test:sh:replenish-loop": "bash tests/test_replenish_loop.sh",
    "test:sh:watch-finish": "bash tests/test_watch_finish.sh",
    "test:sh:watch-ladder": "bash tests/test_watch_ladder.sh",
    "test:sh:watch-race": "bash tests/test_watch_kill_race.sh",
    "test:sh:watchdog": "bash tests/test_watchdog_triage.sh",
    "url": "./smeltr url",
    "verify": "bun run --sequential lint test build",
    "visual": "bun tests/visual/shoot.mts",
    "watchdog": "bash ops/watchdog.sh --supervise",
    "replenisher": "bash ops/replenisher.sh --supervise",
    "pusher": "bash ops/push-complete.sh --supervise"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "lefthook": "2.1.16",
    "oxfmt": "0.66.0",
    "oxlint": "1.81.0",
    "typescript": "^7.0.2"
  },
  "packageManager": "bun@1.4.2"
}
