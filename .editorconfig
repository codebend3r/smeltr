# oxfmt formats JS/CSS (see .oxfmtrc.json); Python is not yet formatted (see
# ruff.toml). For everything else this file is what keeps whitespace consistent.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.py]
indent_size = 4
max_line_length = 100

[*.{sh,bash}]
indent_size = 2

[*.{js,css,html,json,yml,yaml}]
indent_size = 2

# The ledger is append-only JSON Lines and is the irreplaceable record here.
# No editor may reflow or reindent it.
[*.jsonl]
trim_trailing_whitespace = false
insert_final_newline = true

[Makefile]
indent_style = tab
