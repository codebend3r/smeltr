#!/bin/bash
# Smeltr launcher. start | stop | status | report | url
#
# The dashboard is a background process holding a token minted at startup; the
# token is written to ~/.smeltr/url and never logged anywhere else.
set -uo pipefail
# Resolve from this script's own location so the checkout can live anywhere and
# be cloned without editing paths. Override with SMELTR_DIR.
DIR="${SMELTR_DIR:-$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)}"
PIDF="$DIR/server.pid"
PY="${SMELTR_PYTHON:-python3}"
# Bind the dashboard to this machine's LAN address so phones/TVs on the
# network can reach it; the server forces the URL token on whenever it is
# bound off loopback. SMELTR_BIND=127.0.0.1 restores loopback-only.
export SMELTR_BIND="${SMELTR_BIND:-lan}"

# Liveness has to survive a stale pidfile AND a server started outside this
# launcher. Checking only the pidfile once left two servers bound to two ports,
# each printing a different token, so "the" dashboard URL became ambiguous.
# Broad enough to catch the server however it was invoked; the pidfile written
# by the server itself is the authoritative source and is checked first.
# Match the FULL path. A bare "server.py" pattern matched any unrelated
# server.py on the machine -- `stop` would have killed it, and `running` would
# have adopted its pid and reported a stale URL as live.
server_pids() { pgrep -f "$DIR/[d]ashboard/server\.py" 2>/dev/null; }

# The pattern above encodes where the server lives TODAY, and that has already
# moved once: the tree split relocated it from $DIR/server.py to
# $DIR/dashboard/server.py, and the server running the old code kept its old
# command line. `stop` could no longer see it -- it said "not running", dropped
# the pidfile, and `start` then bound a SECOND server to another port, which is
# the two-tokens-two-ports ambiguity the block above exists to prevent. So the
# pidfile is honoured as well as the pattern.
#
# But only after proving the pid is still a smeltr server OF THIS CHECKOUT. A
# pidfile outlives its process and pids are recycled; `kill -0` alone says a
# process exists, not that it is ours, and `stop` would take an unrelated
# process with it. Matching $DIR keeps a second clone's server out of it too.
# -ww because the interpreter path alone can exceed the default width, and a
# truncated command line would hide the $DIR we are matching on.
pidfile_pid() {
  local pid cmd
  pid=$(cat "$PIDF" 2>/dev/null) || return 1
  case "$pid" in ''|*[!0-9]*) return 1 ;; esac
  kill -0 "$pid" 2>/dev/null || return 1
  cmd=$(ps -ww -o command= -p "$pid" 2>/dev/null) || return 1
  case "$cmd" in *"$DIR/"*server.py*) ;; *) return 1 ;; esac
  echo "$pid"
}

# Every live server of this checkout, however it was started. sort -un also
# dedupes the usual case where the pattern and the pidfile name the same pid.
all_server_pids() { { server_pids; pidfile_pid; } 2>/dev/null | sort -un; }

running() {
  [ -n "$(pidfile_pid)" ] && return 0
  local found; found=$(server_pids | head -1)
  if [ -n "$found" ]; then echo "$found" > "$PIDF"; return 0; fi
  return 1
}

start() {
  if running; then echo "already running: $(cat "$DIR/url" 2>/dev/null)"; return 0; fi
  rm -f "$DIR/url"
  nohup "$PY" "$DIR/dashboard/server.py" > "$DIR/server.log" 2>&1 &
  chmod 600 "$DIR/server.log" 2>/dev/null || true
  echo $! > "$PIDF"
  # Wait for the server to publish its URL rather than guessing a sleep length.
  for _ in $(seq 1 100); do
    [ -s "$DIR/url" ] && { echo "$(cat "$DIR/url")"; return 0; }
    perl -e 'select(undef,undef,undef,0.1)' 2>/dev/null || true
  done
  echo "failed to start; see $DIR/server.log" >&2
  tail -5 "$DIR/server.log" >&2
  return 1
}

stop() {
  local pids; pids=$(all_server_pids)
  if [ -n "$pids" ]; then
    # shellcheck disable=SC2086
    kill $pids 2>/dev/null
    # WAIT for them to actually die. Returning immediately meant `restart` saw
    # the dying pid, reported "already running" with a URL that had just been
    # deleted, and started nothing -- leaving no dashboard at all.
    for _ in $(seq 1 50); do
      [ -z "$(all_server_pids)" ] && break
      perl -e 'select(undef,undef,undef,0.1)' 2>/dev/null || true
    done
    if [ -n "$(all_server_pids)" ]; then
      # shellcheck disable=SC2046
      kill -9 $(all_server_pids) 2>/dev/null
    fi
    echo "stopped"
  else
    echo "not running"
  fi
  rm -f "$PIDF" "$DIR/url"
}

case "${1:-report}" in
  start)  start ;;
  stop)   stop ;;
  restart) stop >/dev/null; start ;;
  status) running && echo "running: $(cat "$DIR/url" 2>/dev/null)" || echo "not running" ;;
  url)    cat "$DIR/url" 2>/dev/null || { echo "not running" >&2; exit 1; } ;;
  report) shift 2>/dev/null; running || start >/dev/null 2>&1; exec "$PY" "$DIR/dashboard/report.py" "$@" ;;
  record) shift; exec "$PY" "$DIR/pipeline/record.py" "$@" ;;
  verdict) shift; exec "$PY" "$DIR/pipeline/verdict.py" "$@" ;;
  next) shift; exec "$PY" "$DIR/pipeline/next_title.py" "$@" ;;
  open)   running || start >/dev/null 2>&1; exec open "$(cat "$DIR/url")" ;;
  *)      echo "usage: smeltr {start|stop|restart|status|url|open|report [...]|record <folder> [...]}" >&2; exit 2 ;;
esac
