# Runtime artifacts, regenerated on every start. server.log and url can contain
# the auth token, and `token` IS the persisted auth token, so none may ever be
# committed.
url
token
server.pid
server.log
__pycache__/
*.pyc
node_modules/
queue_overrides.json
pause

# Git worktrees checked out inside the repo. Never committable: each is a full
# second copy of the tree AND carries its own runtime `token` file, so staging
# one would commit the live auth token the ignores above exist to keep out.
.claude/worktrees/
