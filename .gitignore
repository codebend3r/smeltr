# Runtime artifacts, regenerated on every start. server.log and url can contain
# the auth token, and `token` IS the persisted auth token, so none may ever be
# committed.
url
token
server.pid
server.log
__pycache__/
*.pyc
sysmon.ring
node_modules/
queue_overrides.json
encoder_overrides.json
*.json.tmp
pause
# notify.json holds the Slack webhook and the Gmail app password; notify.cursor
# is the notifier's seen-set and pending sends.
notify.json
# auth.json holds the dashboard's password verifier AND its cookie-signing
# secret; a committed secret is a forgeable session for anyone with the repo.
auth.json
notify.cursor
notify.cursor.*

# The live encode ledger. Written by `record.py` on every finished encode, so a
# tracked copy conflicts on every driver cycle. Stays on disk — untracking it
# does not remove it, and the driver keeps appending.
ledger.jsonl

# Git worktrees checked out inside the repo. Never committable: each is a full
# second copy of the tree AND carries its own runtime `token` file, so staging
# one would commit the live auth token the ignores above exist to keep out.
.claude/worktrees/
manual_adds.json
no-delete
encode_budget
encode_done
